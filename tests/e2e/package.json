{
    "name": "cacti-e2e",
    "private": true,
    "version": "0.0.0",
    "description": "Playwright end-to-end tests for Cacti",
    "scripts": {
        "test": "playwright test",
        "test:htmx": "playwright test tests/htmx-loader.spec.ts",
        "test:smoke": "playwright test tests/login-smoke.spec.ts",
        "install-browsers": "playwright install --with-deps chromium",
        "coverage:report": "node coverage/report.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "v8-to-istanbul": "9.3.0",
        "istanbul-lib-coverage": "3.2.2",
        "istanbul-lib-report": "3.0.1",
        "istanbul-reports": "3.2.0"
    }
}
