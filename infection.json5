{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["lib"],
        "excludes": ["vendor"]
    },
    "timeout": 30,
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "mutators": {
        "@default": true
    },
    "phpUnit": {
        "configDir": ".",
        "customPath": "include/vendor/bin/pest"
    },
    "testFramework": "pest",
    "testFrameworkOptions": "--display-warnings"
}
