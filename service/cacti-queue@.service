[Unit]
Description=Cacti Queue Worker (%i)
After=network.target
# queue_worker.php exits 1 for bad arguments and configuration, but also when
# a message fails or the worker loop throws, so RestartPreventExitStatus=1
# would strand workers after a transient database outage. Cap the restart
# loop instead: 10 starts within 10 minutes leaves the unit failed.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# Run as the web server account that owns the Cacti tree, as in cactid.service.
# RedHat variants usually use apache:apache, Debian variants www-data:www-data.
User=apache
Group=apache
ExecStart=/usr/bin/php /var/www/html/cacti/cli/queue_worker.php --queue=%i
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
