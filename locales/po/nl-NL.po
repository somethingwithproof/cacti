msgstr "Voer de SMTP timeout in seconden in."

#: include/global_settings.php:1714
msgid "Bind Timeout"
msgstr "Timeout"

#: include/global_settings.php:1715
msgid "The Bind Timeout in seconds."
msgstr "Voer de SMTP timeout in seconden in."

