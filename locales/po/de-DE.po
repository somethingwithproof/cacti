msgstr "Kontosperre"

#: include/global_settings.php:1638
msgid "Lock Accounts"
msgstr "Konten sperren"

#: include/global_settings.php:1639
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "Sperren Sie ein Konto nach diesem vielen fehlgeschlagenen Versuchen in 1 Stunde."

#: include/global_settings.php:1644
msgid "1 Attempt"
msgstr "1 Versuch"

#: include/global_settings.php:1645 include/global_settings.php:1646
#: include/global_settings.php:1647 include/global_settings.php:1648
#: include/global_settings.php:1649
