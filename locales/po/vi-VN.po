msgid "%d Changes"
msgstr "% d Thay đổi"

#: include/global_settings.php:1633
msgid "Account Locking"
msgstr "Khóa tài khoản"

#: include/global_settings.php:1638
msgid "Lock Accounts"
msgstr "Khóa tài khoản"

#: include/global_settings.php:1639
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "Khóa tài khoản sau nhiều lần thất bại trong 1 giờ."

#: include/global_settings.php:1644
msgid "1 Attempt"
msgstr "1 lần thử"

#: include/global_settings.php:1645 include/global_settings.php:1646
#: include/global_settings.php:1647 include/global_settings.php:1648
#: include/global_settings.php:1649
#, php-format
msgid "%d Attempts"
msgstr "% d Nỗ lực"

#: include/global_settings.php:1652
msgid "Auto Unlock"
msgstr "Tự động mở khóa"

#: include/global_settings.php:1653
msgid "An account will automatically be unlocked after this many minutes.  Even if the correct password is entered, the account will not unlock until this time limit has been met.  Max of 1440 minutes (1 Day)"
msgstr "Một tài khoản sẽ tự động được mở khóa sau nhiều phút. Ngay cả khi nhập đúng mật khẩu, tài khoản sẽ không mở khóa cho đến khi đạt được giới hạn thời gian này. Tối đa 1440 phút (1 ngày)"

#: include/global_settings.php:1669 include/global_settings.php:2889
msgid "1 Day"
msgstr "1 Ngày"

#: include/global_settings.php:1672
msgid "LDAP General Settings"
msgstr "Cài đặt chung LDAP"

#: include/global_settings.php:1676 user_domains.php:367
msgid "Server(s)"
msgstr "May chu"

#: include/global_settings.php:1677 user_domains.php:368
msgid "A space delimited list of DNS hostnames or IP address of for valid LDAP servers.  Cacti will attempt to use the LDAP servers from left to right to authenticate a user."
msgstr "Danh sách tên máy chủ DNS hoặc địa chỉ IP được phân tách bằng dấu cách cho các máy chủ LDAP hợp lệ. Cacti sẽ cố gắng sử dụng các máy chủ LDAP từ trái sang phải để xác thực người dùng."

#: include/global_settings.php:1683 user_domains.php:376
msgid "Port Standard"
msgstr "Tiêu chuẩn cảng"

#: include/global_settings.php:1684
msgid "TCP port for Non-SSL communications including LDAP + TLS.  Default is 389."
msgstr "Cổng TCP / UDP cho giao tiếp không SSL."

#: include/global_settings.php:1691 user_domains.php:385
msgid "Port SSL"
msgstr "Cổng SSL"

#: include/global_settings.php:1692
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "Cổng TCP / UDP cho truyền thông không SSL."

#: include/global_settings.php:1699 user_domains.php:394
msgid "Protocol Version"
msgstr "Phiên bản giao thức"

#: include/global_settings.php:1700
msgid "Protocol Version to connect to the server with."
msgstr "Phiên bản giao thức mà máy chủ hỗ trợ."

#: include/global_settings.php:1706
msgid "Connect Timeout"
msgstr "Hết thời gian kết nối"

#: include/global_settings.php:1707
msgid "The Network Connect Timeout in seconds."
msgstr "Vui lòng nhập thời gian chờ SMTP trong vài giây."

#: include/global_settings.php:1714
msgid "Bind Timeout"
msgstr "Hết giờ"

#: include/global_settings.php:1715
msgid "The Bind Timeout in seconds."
msgstr "Vui lòng nhập thời gian chờ SMTP trong vài giây."

#: include/global_settings.php:1722
msgid "LDAP Debug Mode"
msgstr "Chế độ gỡ lỗi LDAP"

#: include/global_settings.php:1723
msgid "If Checked Cacti will log extra LDAP information to the Cacti log during Binding and Searching activities."
msgstr "Nếu được Kiểm tra Xương rồng sẽ ghi thông tin LDAP bổ sung vào nhật ký Xương rồng trong các hoạt động Ràng buộc và Tìm kiếm."

#: include/global_settings.php:1728 user_domains.php:401
msgid "Encryption"
msgstr "Mã hóa"

#: include/global_settings.php:1729
msgid "Encryption that the server supports. NOTE: When using LDAP + TLS you must use version 3."
msgstr "Mã hóa mà máy chủ hỗ trợ. TLS chỉ được hỗ trợ bởi Giao thức Phiên bản 3."

#: include/global_settings.php:1735
msgid "TLS Certificate Requirements"
msgstr "Yêu cầu chứng chỉ TLS"

#: include/global_settings.php:1736
msgid "Should LDAP verify TLS Certificates when received by the Client."
msgstr "LDAP có nên xác minh Chứng chỉ TLS khi Khách hàng nhận được không."

#: include/global_settings.php:1742 user_domains.php:408
msgid "Referrals"
msgstr "Giới thiệu"

#: include/global_settings.php:1743 user_domains.php:409
msgid "Enable or Disable LDAP referrals.  If disabled, it may increase the speed of searches."
msgstr "Kích hoạt hoặc vô hiệu hóa các giới thiệu LDAP. Nếu bị tắt, nó có thể tăng tốc độ tìm kiếm."

#: include/global_settings.php:1752 user_domains.php:415
msgid "Mode"
msgstr "Chế độ"

#: include/global_settings.php:1753
msgid "Mode which cacti will attempt to authenticate against the LDAP server.<blockquote><i>No Searching</i> - No Distinguished Name (DN) searching occurs, just attempt to bind with the provided Distinguished Name (DN) format.<br><br><i>Anonymous Searching</i> - Attempts to search for username against LDAP directory via anonymous binding to locate the user's Distinguished Name (DN).<br><br><i>Specific Searching</i> - Attempts search for username against LDAP directory via Specific Distinguished Name (DN) and Specific Password for binding to locate the user's Distinguished Name (DN)."
msgstr "Chế độ mà xương rồng sẽ cố gắng xác thực với máy chủ LDAP. <blockquote> <i>Không tìm kiếm</i> - Không xảy ra tìm kiếm Tên phân biệt (DN), chỉ cần cố gắng liên kết với định dạng Tên phân biệt (DN) được cung cấp. <br><br> <i>Tìm kiếm ẩn danh</i> - Cố gắng tìm kiếm tên người dùng đối với thư mục LDAP thông qua liên kết ẩn danh để xác định tên phân biệt (DN) của người dùng. <br><br> <i>Tìm kiếm cụ thể</i> - Cố gắng tìm kiếm tên người dùng đối với thư mục LDAP thông qua Tên phân biệt cụ thể (DN) và Mật khẩu cụ thể để liên kết để xác định tên phân biệt (DN) của người dùng."

#: include/global_settings.php:1759 user_domains.php:422
msgid "Distinguished Name (DN)"
msgstr "Tên phân biệt (DN)"

#: include/global_settings.php:1760 user_domains.php:423
msgid "The \"Distinguished Name\" syntax, applicable for both OpenLDAP and Windows AD configurations, offers flexibility in defining user identity. For OpenLDAP, the format follows this structure: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD provides an alternative syntax: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, commonly known as \"userPrincipalName (UPN)\". In this context, \"&lt;username&gt;\" represents the specific username provided during the login prompt. This is particularly pertinent when operating in \"No Searching\" mode, or \"Require Group Membership\" enabled."
msgstr ""

#: include/global_settings.php:1766 user_domains.php:430
msgid "Require Group Membership"
msgstr "Yêu cầu thành viên nhóm"

#: include/global_settings.php:1767 user_domains.php:431
msgid "Require user to be member of group to authenticate. Group settings must be set for this to work, enabling without proper group settings will cause authentication failure."
msgstr "Yêu cầu người dùng là thành viên của nhóm để xác thực. Cài đặt nhóm phải được đặt để hoạt động này, cho phép không có cài đặt nhóm thích hợp sẽ gây ra lỗi xác thực."

#: include/global_settings.php:1772 user_domains.php:436
msgid "LDAP Group Settings"
msgstr "Cài đặt nhóm LDAP"

#: include/global_settings.php:1776 user_domains.php:440
msgid "Group Distinguished Name (DN)"
msgstr "Tên phân biệt nhóm (DN)"

#: include/global_settings.php:1777 user_domains.php:441
msgid "Distinguished Name of the group that user must have membership."
msgstr "Tên phân biệt của nhóm mà người dùng phải có thành viên."

#: include/global_settings.php:1783 user_domains.php:447
msgid "Group Member Attribute"
msgstr "Thuộc tính thành viên nhóm"

#: include/global_settings.php:1784 user_domains.php:448
msgid "This refers to the specific attribute within the LDAP directory that holds the usernames of group members. It is crucial to ensure that the attribute value aligns with the configuration specified in the \"Distinguished Name\" or that the actual attribute value is searchable using the settings outlined in the \"Distinguished Name\"."
msgstr ""

#: include/global_settings.php:1790 user_domains.php:454
msgid "Group Member Type"
msgstr "Loại thành viên nhóm"

#: include/global_settings.php:1791 user_domains.php:455
msgid "Defines if users use full Distinguished Name or just Username in the defined Group Member Attribute."
msgstr "Xác định nếu người dùng sử dụng Tên phân biệt đầy đủ hoặc chỉ Tên người dùng trong Thuộc tính thành viên nhóm được xác định."

#: include/global_settings.php:1795
msgid "Distinguished Name"
msgstr "Tên phân biệt"

#: include/global_settings.php:1800 user_domains.php:461
msgid "LDAP Specific Search Settings"
msgstr "Cài đặt tìm kiếm cụ thể LDAP"

#: include/global_settings.php:1804 user_domains.php:465
msgid "Search Base"
msgstr "Cơ sở tìm kiếm"

#: include/global_settings.php:1805
msgid "Search base for searching the LDAP directory, such as <i>'dc=win2kdomain,dc=local'</i> or <i>'ou=people,dc=domain,dc=local'</i>."
msgstr "Cơ sở tìm kiếm để tìm kiếm thư mục LDAP, chẳng hạn như <i>&#39;dc = win2kdomain, dc = local&#39;</i> hoặc <i>&#39;ou = people, dc = domain, dc = local&#39;</i> ."

#: include/global_settings.php:1810 user_domains.php:472
msgid "Search Filter"
msgstr "Tìm kiếm Bộ lọc"

#: include/global_settings.php:1811
msgid "Search filter to use to locate the user in the LDAP directory, such as for windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> or for OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' is replaced with the username that was supplied at the login prompt. "
msgstr "Bộ lọc tìm kiếm để sử dụng để định vị người dùng trong thư mục LDAP, chẳng hạn như cho windows: <i>&#39;(&amp; (objectgroup = user) (objectcarget = user) (userPrincipalName = &lt;username&gt; *))&#39;</i> hoặc cho OpenLDAP: <i>&#39;(&amp; (objectClass = tài khoản) (uid = &lt;tên người dùng&gt;)) &#39;</i> . &#39;&lt;tên người dùng&gt;&#39; được thay thế bằng tên người dùng được cung cấp tại dấu nhắc đăng nhập."

#: include/global_settings.php:1816 user_domains.php:479
msgid "Search Distinguished Name (DN)"
