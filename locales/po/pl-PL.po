msgstr "Maksymalny czas działania skryptu aktualizacji RRD"

#: include/global_settings.php:2568
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log,"
msgstr "Jeśli ankieter Boost wykona ten czas działania, w dzienniku Cacti zostanie umieszczone ostrzeżenie,"

#: include/global_settings.php:2574
