msgstr "Текущее время пинга в миллисекундах для достижения Устройства."

#: host.php:1827
msgid "Average (ms)"
msgstr "Срейдний (мс)"

#: host.php:1830
msgid "The average ping time in milliseconds to reach the Device since the counters were cleared for this Device."
msgstr "Среднее время пингового сигнала в миллисекундах для достижения Устройства с момента сброса счетчиков для данного Устройства."

#: host.php:1833
msgid "Availability"
msgstr "Доступность"

#: host.php:1836
